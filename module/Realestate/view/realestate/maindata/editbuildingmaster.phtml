<script>
$('document').ready(function(){
	$('#region').on('change',function(){
		//alert($('#region').val());
		$.post(
			'<?php echo $this->url('assets', array('action' => 'getlocation')); ?>',
			{
				region: $(this).val(),
			},
			function(data){
				//console.log(data);	
				$('#location').html(data.location);	
				$("#location").trigger("chosen:updated");			
			},
			'json'
		);
	});

	$('#rent_block').on('change', function(){
		$.post(
			'<?php echo $this->url('rsdata', array('action' => 'getassetbyblock')); ?>',
			{
				block: $(this).val(),
			},
			function(data){
				$('#rent_asset').html(data.asset);
				$('#rent_asset').trigger('chosen:updated');
			},
			'json'
		);
	});

	$('#rent_head').on('change', function(){
		$.post(
			'<?php echo $this->url('rsdata', array('action' => 'getsubhead')); ?>',
			{
				head: $(this).val(),
			},
			function(data){
				$('#rent_sub_head').html(data.subhead);
				$('#rent_sub_head').trigger('chosen:updated');
			},
			'json'
		);
	});

	function toggleRentAccountingConfig() {
		if ($('#generate_rent').val() === '1') {
			$('.rent-accounting-config').show();
		} else {
			$('.rent-accounting-config').hide();
			$('#rent_head').val('').trigger('chosen:updated');
			$('#rent_sub_head').html("<option value=''></option>").trigger('chosen:updated');
		}
	}
	$('#generate_rent').on('change', toggleRentAccountingConfig);
	toggleRentAccountingConfig();
	
	$("#purchase_date").datepicker();	
	$("#putin_date").datepicker();
   
    const fv = FormValidation.formValidation(document.getElementById('#form'), {
		fields: {
			code: {
				validators: {
					notEmpty: {
						message: 'Please select Code.'
					}
				}
			},
		},
		plugins: {
			trigger: new FormValidation.plugins.Trigger(),
			bootstrap3: new FormValidation.plugins.Bootstrap3(),
			submitButton: new FormValidation.plugins.SubmitButton(),
			defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
		},
	}).on('core.element.validated', function (e) {
		if (e.valid) {
			$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-invalid');
			$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-valid');
		} else {
			$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-valid');
			$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-invalid');
		}
	});
	$('form select').chosen().change(function () {
		fv.revalidateField($(this).attr('name'));
	});
});
</script>
	
