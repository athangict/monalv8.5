<script type="text/javascript">
$(document).ready(function () {
	$('#print').on('click', function(e){
		e.preventDefault();
		var reportdom = $('#print-content').clone(true);
		reportdom.find('.row').css({'margin':'0'});
		reportdom.find('[class*="col-"]').css({'padding':'0','margin':'0'});
		reportdom.find('a').remove();
		reportdom.find('td.no-print, th.no-print').remove();
		var leftSummaryHtml = reportdom.find('#convert-tb1').html() || '';
		var rightSummaryHtml = reportdom.find('#convert-tb2').html() || '';
		reportdom.find('#convert-tb0').replaceWith(
			'<table width="100%" id="nivoice-tab0" style="border-collapse:collapse;"><tr>' +
				'<td width="65%" style="width:65%;text-align:left;vertical-align:top;">' + leftSummaryHtml + '</td>' +
				'<td width="35%" style="width:35%;text-align:left;vertical-align:top;">' + rightSummaryHtml + '</td>' +
			'</tr></table>'
		);
		reportdom.find('div').each(function(){
			var $this = $(this);
			if($this.hasClass('space') && $this.html().replace(/\s|&nbsp;/g, '').length === 0){
				$this.remove();
				return;
			}
			$this.has('div').contents().unwrap();
		});
		reportdom.find('span').removeClass().removeAttr('style');
		reportdom.contents().filter(function(){ return (this.nodeType === 3 && !/\S/.test(this.nodeValue)); }).remove();
		var pdfTable = reportdom.find('table.table').first();
		if (pdfTable.length) {
			var pdfColWidths = ['6mm','21mm','21mm','21mm','21mm','21mm','21mm','21mm','37mm'];
			pdfTable.attr('width', '190mm').css({'width':'190mm','max-width':'190mm','table-layout':'fixed','margin':'0','border':'1px solid #ddd','border-collapse':'collapse'});
			pdfTable.find('tr').each(function(){
				var $cells = $(this).children('th,td');
				if($cells.length > 9){
					$cells.slice(9).remove();
					$cells = $(this).children('th,td');
				}
				$cells.each(function(idx){
					$(this).attr('width', pdfColWidths[idx] || '').css({'width': (pdfColWidths[idx] || '')});
				});
			});
		}
		$('#report_form').remove();
		var form = "<form id='report_form' method='post' action='<?php echo $this->url('print', array('action' => 'index'));?>' target='iframe'>"+
			"<input type='hidden' name='dom'/>"+
			"<input type='hidden' name='title' value='report'/>"+
			"<input type='hidden' name='orentation' value='P'/>"+
			"<input type='hidden' name='size' value='A4'/>"+
			"</form>";
		$('body').append(form);
		$('#report_form input[name=dom]').val($.trim(reportdom.html()));
		$('#report_form input[name=title]').val($(document).find('title').text());
		$('#report_form').trigger('submit');
	});
});

</script>

