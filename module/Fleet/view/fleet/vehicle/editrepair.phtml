<script type="text/javascript">	 
function purchase_reset(row) {
	row.find('.tr_service').val('');
	row.find('.tr_item').html('<option value=""></option>');
	row.find('.tr_amount').val('0.00');
	row.find('.tr_plate').val('');
	calculateTotalAmount();
}
function purchase_actionbtn() {
	if ($('#purchase_field_body tr').length > 1) {
		var delBtn = "<button class='btn btn-warning btn-xs removeRow' type='button' style='margin-top:5px;'><i class='fa fa-times'></i></button>";
		$('#purchase_field_body tr').each(function() {
			$(this).find('td.action-cell').html(delBtn);
		});
	} else {
		var resetBtn = "<button class='btn btn-warning btn-xs resetRow' type='button' style='margin-top:5px;'><i class='fa fa-refresh'></i></button>";
		$('#purchase_field_body tr').each(function() {
			$(this).find('td.action-cell').html(resetBtn);
		});
	}
}
function purchase_field() {
	var lastRow = parseInt($('#purchase_field_body tr:last').attr('id'), 10) || 0;
	var clone = $('#purchase_field_body tr:first').clone(false);
	clone.attr('id', ++lastRow);
	clone.attr('data-detail-id', '0');
	clone.find('#details_id').remove();
	clone.find('.tr_plate').val('');
	clone.find('.tr_item').html('<option value=""></option>');
	clone.find('.tr_amount').val('0.00');
	clone.find('.tr_service').val('');
	$('#purchase_field_body').append(clone);
	purchase_actionbtn();
	calculateTotalAmount();
}
$(document).on('click', '.removeRow', function() {
	var row = $(this).closest('tr');
	var detailId = parseInt(row.attr('data-detail-id'), 10) || 0;
	if (detailId > 0) {
		$('#deleted_detail_ids').append('<input type="hidden" name="deleted_details_id[]" value="' + detailId + '">');
	}
	row.remove();
	purchase_actionbtn();
	calculateTotalAmount();
});
$(document).on('click', '.resetRow', function() {
	purchase_reset($(this).closest('tr'));
});
function refreshHeadByLocationEdit() {
	var selectedLocation = $('#location').val();
	$.post(
		"<?php echo $this->url('vehicle', array('action' => 'getlocationhead')); ?>",
		{
			locationId: selectedLocation,
		},
		function(data) {
			$('#purchase_field_body .tr_service').each(function() {
				$(this).html(data.head);
				$(this).val('');
				$(this).trigger('chosen:updated');
				$(this).closest('tr').find('.tr_item').html('<option value=""></option>');
				$(this).closest('tr').find('.tr_item').trigger('chosen:updated');
				$(this).closest('tr').find('.tr_plate').val('');
			});
		},
		'json'
	);
}
$('#location').on('change', function() {
	refreshHeadByLocationEdit();
});
$(document).on('change', '.tr_service', function() {
    var selectedService = $(this).closest('tr').find('.tr_service').val();
    var selectedLocation = $('#location').val();
    var relatedItemElement = $(this).closest('tr').find('.tr_item');

    $.post(
        "<?php echo $this->url('vehicle', array('action' => 'gettransport')); ?>",
        {
            serviceId: selectedService,
            locationId: selectedLocation,
        },
        function(data) {
            relatedItemElement.html(data.item);
            relatedItemElement.trigger('chosen:updated');
		  },
        'json'
    );  
});
$(document).on('change', '.tr_service, .tr_item', function() {
    var selectedService = $(this).closest('tr').find('.tr_service').val();
     var selectedItem = $(this).closest('tr').find('.tr_item').val();
    var relatedItemElement = $(this).closest('tr').find('.tr_plate');

    $.post(
        "<?php echo $this->url('vehicle', array('action' => 'getplate')); ?>",
        {
            serviceId: selectedService,
            itemId: selectedItem,
        },
        function(data) {
            relatedItemElement.val(data.license_plate);
		 },
        'json'
    );  
});
	
	$(document).on('input', '.tr_amount,.tr_quantity', function () {
		calculateTotalAmount();
		});
	$(document).on('input', '.tr_rate, .tr_quantity', function() {
		calculateTotal($(this));
	});
	function calculateTotal(element) {
		var row = element.closest('tr');  // Get the closest table row

		var rateInput = row.find('.tr_rate');  // Adjusted these to use class selectors and scope within the row
		//var quantityInput = row.find('.tr_quantity');
		var totalInput = row.find('.tr_amount'); // Assuming there's a field for the total amount with the class "tr_amount"

		var rate = parseFloat(rateInput.val()) || 0;
		//var quantity = parseFloat(quantityInput.val()) || 0;
		var total = rate ;

		totalInput.val(total.toFixed(2));  // Assuming you want to show up to two decimal places
		calculateTotalAmount();
	}
	function calculateTotalAmount() {
		console.log("calculateTotal amount");
		var total = 0.0;

		// Iterate over each amount input field in the table
		$('.tr_amount').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				total += amount;
			}
		});

		// Update the #total field with the new sum
		$('#rm_amount').val(total.toFixed(2));
	}
