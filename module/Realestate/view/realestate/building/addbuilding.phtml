<script type="text/javascript">
function floor_reset(row) {
	row.find('.tr_floor').val('').trigger('chosen:updated');
	row.find('.tr_flat_no').val('');
	row.find('.tr_rent').val('');
	row.find('.tr_flat_status').val('').trigger('chosen:updated');
	row.find('.tr_area').val('');
	row.find('.tr_remarks').val('');
}
function floor_actionbtn() {
	if ($('#floor_field_body tr').length > 1) {
		var delBtn = "<a value='Delete' class='btn btn-warning btn-xs delRow' style='margin-top:22px;'><i class='fa fa-times'></i></a>";
		$('#floor_field_body tr').each(function() {
			$(this).find('td:last').html(delBtn);
		});
		$('#floor_field_body td a.delRow').each(function() {
			$(this).off('click').on('click', function() {
				remove_floor_field($(this).closest('tr'));
			});
		});
	} else {
		var resetBtn = "<a value='Reset' class='btn btn-warning btn-xs resetRow' style='margin-top:22px;'><i class='fa fa-refresh'></i></a>";
		$('#floor_field_body tr').each(function() {
			$(this).find('td:last').html(resetBtn);
		});
		$('#floor_field_body td a.resetRow').each(function() {
			$(this).off('click').on('click', function() {
				floor_reset($(this).closest('tr'));
			});
		});
	}
}
function floor_field() {
	var lastRow = parseInt($('#floor_field_body tr:last').attr('id'), 10) || 0;
	var tmplt_row = $('#floor_field_body tr:first').clone(false);
	var clone = tmplt_row.clone();
	clone.find('div.chosen-container').remove();
	clone.find('select').each(function() {
		$(this).removeClass('chosen-done').show();
		$(this).next('.chosen-container').remove();
	});
	clone.attr('id', ++lastRow);
	clone.find(':input').each(function() {
		var old_id = $(this).attr('id');
		if (!old_id) {
			return;
		}
		var new_id = (old_id.lastIndexOf('-') > 0) ? old_id.substr(0, old_id.lastIndexOf('-')) : old_id;
		$(this).attr('id', new_id + '-' + lastRow);
		$(this).addClass('tr-' + new_id);
	});
	$('#floor_field_body').append(clone);
	floor_reset(clone);
	if ($.fn.chosen) {
		clone.find('select').chosen();
	}
	floor_actionbtn();
}
function remove_floor_field(row) {
	row.remove();
	floor_actionbtn();
}
    $(function() {
		$('#location,#block').on('change', function(){
