<script type="text/javascript">
$(document).ready(function () {
	$('#print').on('click', function(e){
		e.preventDefault();
		var reportdom = $('#report-print').clone(true);
		var pdfStyle = '<style>' +
			'#pdf-summary, #pdf-summary td {border:none !important;}' +
			'table.table, table.table th, table.table td {border-color:#ddd !important;}' +
			'table.table th, table.table td {border-width:1px !important; border-style:solid !important;}' +
			'.red {color:#000 !important;}' +
		'</style>';
		reportdom.prepend(pdfStyle);
		var leftSummaryHtml = reportdom.find('#convert-tb1').html() || '';
		var rightSummaryHtml = reportdom.find('#convert-tb2').html() || '';

		reportdom.find('#convert-tb0').replaceWith(
			'<div style="height:8px;"></div>' +
			'<table id="pdf-summary" width="100%" style="width:100%;border-collapse:collapse;border:none;">' +
				'<tr>' +
					'<td width="65%" style="width:65%;text-align:left;vertical-align:top;padding:8px;border:none;">' + leftSummaryHtml + '</td>' +
					'<td width="35%" style="width:35%;text-align:left;vertical-align:top;padding:8px;">' + rightSummaryHtml + '</td>' +
				'</tr>' +
			'</table>'
		);

		reportdom.find('i').remove();
		reportdom.find('.red').removeClass('red');
		reportdom.find('ul').css({'list-style':'none','margin':'0','padding':'0'});
		reportdom.find('li').css({'margin':'0 0 4px 0','padding':'0'});
		reportdom.find('.row').css({'margin':'0'});
		reportdom.find('[class*="col-"]').css({'padding':'0','margin':'0'});
		reportdom.find('table').css({
			'width':'100%',
			'max-width':'100%',
			'border-collapse':'collapse',
			'table-layout':'fixed'
		});
		reportdom.find('th, td').css({
			'border':'1px solid #ddd',
			'padding':'4px',
			'word-break':'break-word'
		});
		reportdom.find('#pdf-summary, #pdf-summary td').css({'border':'none'});
		reportdom.find('div').each(function(){
			var $this = $(this);
			if($this.hasClass('space-6') && $this.html().replace(/\s|&nbsp;/g, '').length === 0){
				$this.remove();
				return;
			}
			$this.has('div').contents().unwrap();
		});

		$('#report_form').remove();
		var form = "<form id='report_form' method='post' action='<?php echo $this->url('print', array('action' => 'index'));?>' target='iframe'>"+
			"<input type='hidden' name='dom'/>"+
			"<input type='hidden' name='title' value='report'/>"+
			"<input type='hidden' name='orentation' value='P'/>"+
			"<input type='hidden' name='size' value='A4'/>"+
			"<input type='hidden' name='hide_header' value='1'/>"+
			"</form>";
		$('body').append(form);
		$('#report_form input[name=dom]').val($.trim(reportdom.html()));
		$('#report_form input[name=title]').val($(document).find('title').text());
		$('#report_form').trigger('submit');
	});
});
</script>
