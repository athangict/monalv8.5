					location_id: $('#location').val(),
					type: $('#block').val(),
				},
				function(data){
					console.log(data);
					$('#building').html(data.building);
					$('#building').trigger('chosen:updated');
				},
				'json'
			);
		});
		$('#rent_head').on('change', function(){
			$.post(
				"<?php echo $this->url('building', array('action' => 'getsubhead')); ?>",
				{
					head: $('#rent_head').val(),
				},
				function(data){
					$('#rent_sub_head').html(data.subhead);
					$('#rent_sub_head').trigger('chosen:updated');
				},
				'json'
			);
		});
		function toggleRentAccountingConfig() {
			if ($('input[name="generate_rent"]').is(':checked')) {
				$('.rent-accounting-config').show();
			} else {
				$('.rent-accounting-config').hide();
				$('#rent_head').val('').trigger('chosen:updated');
				$('#rent_sub_head').html("<option value=''></option>").trigger('chosen:updated');
			}
		}
		$('input[name="generate_rent"]').on('change', toggleRentAccountingConfig);
		toggleRentAccountingConfig();
		$('#location').trigger('change');
		$('select#region').on('change',function(){
			$.post(
