<script type="text/javascript">
$(function() {	
	$("#vehicle_no").bind('keyup', function (e) {
		if (e.which >= 97 && e.which <= 122) {
			var newKey = e.which - 32;
			// I have tried setting those
			e.keyCode = newKey;
			e.charCode = newKey;
		}
		$("#vehicle_no").val(($("#vehicle_no").val()).toUpperCase());
	});
	$("#transporter_nonfcb").bind('keyup', function (e) {
		if (e.which >= 97 && e.which <= 122) {
			var newKey = e.which - 32;
			// I have tried setting those
			e.keyCode = newKey;
			e.charCode = newKey;
		}
		$("#transporter_nonfcb").val(($("#transporter_nonfcb").val()).toUpperCase());
	});
	/*** onChange of fcb_transport ***/
	if($('input[name="fcb_transport"]:checked').val() == '0'){
		$("div#fcb").hide();
		$("div#non_fcb").show();
	}else{
		$("div#fcb").show();
		$("div#non_fcb").hide();
	}
	$("input[name='fcb_transport']").change(function(e){
		if($(this).val() == '0') {
			$("div#fcb").hide();
			$("div#non_fcb").show();
			$('select#transporter_fcb option:selected').removeAttr('selected');
			$("select#transporter_fcb").trigger("chosen:updated");
			$('select#party option:selected').removeAttr('selected');
			$("select#party").trigger("chosen:updated");
		} else {
			$("div#fcb").show();
			$("div#non_fcb").hide();
			$("input[name='transporter_nonfcb']").val('');
			$('select#party option:selected').removeAttr('selected');
			$('select#party option[value=323]').attr('selected', 'selected');
			$("select#party").trigger("chosen:updated");
		}
	});
	
	$('#issue_date').datepicker();
	$('#issue_date').on('changeDate',function(){
		$('form').formValidation('revalidateField', $(this).attr('id'));
	});
	var loadIssuedEmployees = function(departmentId, selectedEmployeeId){
		$('#issued_to').html("<option value=''></option>").trigger('chosen:updated');
		$('#to_location').val('');
		if(!departmentId){
			return;
		}
		$.post(
			'<?php echo $this->url("inissue", array("action" => "getissuedtoemployee"));?>',
			{
				department: departmentId
			},
			function(data){
				$('#issued_to').html(data.employees);
				if(selectedEmployeeId){
					if($('#issued_to option[value="'+selectedEmployeeId+'"]').length === 0){
						var selectedLabel = $('#issue_received_by_label').val() || selectedEmployeeId;
						$('#issued_to').append('<option value="'+selectedEmployeeId+'" selected>'+selectedLabel+'</option>');
					}
					$('#issued_to').val(selectedEmployeeId);
				}
				$('#issued_to').trigger('chosen:updated');
				var selectedLocation = $('#issued_to option:selected').data('location') || '';
				$('#to_location').val(selectedLocation);
				$('#trdetails_table tbody tr').each(function(){
					var rowId = $(this).attr('id');
					$('#item-'+rowId).trigger('change');
				});
				var enforceIssueQtyLimit = function(inputObj){
					var $input = $(inputObj);
					var rowId = $input.closest('tr').attr('id');
					var stockValue = '';
					if(rowId && $('#from_balance-'+rowId).length){
						stockValue = $('#from_balance-'+rowId).val();
					} else {
						stockValue = $input.closest('tr').find('input[name="from_balance[]"]').val();
					}
					var stockQty = parseFloat(String(stockValue || '').replace(/,/g, ''));
					var issueQty = parseFloat(String($input.val() || '').replace(/,/g, ''));
					if($.isNumeric(stockQty) && $.isNumeric(issueQty) && issueQty > stockQty){
						$input.val(parseFloat(stockQty).toFixed(2)).trigger('input');
					}
				};
				$(document).on('input keyup change', '#trdetails_table tbody input[name="quantity[]"]', function(){
					enforceIssueQtyLimit(this);
				});
			},
			'json'
		);
	};
	$('#department').change(function(){
		loadIssuedEmployees($(this).val(), '');
	});
	$('#issued_to').change(function(){
		var locationId = $('#issued_to option:selected').data('location') || '';
		$('#to_location').val(locationId);
		$('#trdetails_table tbody tr').each(function(){
			var rowId = $(this).attr('id');
			$('#item-'+rowId).trigger('change');
		});
	});
	loadIssuedEmployees($('#department').val(), $('#issue_received_by').val());

	var initIssueRows = function(){
		if($('#trdetails_table tbody tr:first').attr('id')){
			return;
		}
		$('#trdetails_table').issue({
			getToLocation:'<?php echo $this->url('inissue', array('action' => 'gettolocation'));?>',
			getItem:'<?php echo $this->url("inissue", array("action" => "getitemgroup"));?>',
			getDetails:'<?php echo $this->url("inissue", array("action" => "getdetails"));?>',
			getStockBalance:'<?php echo $this->url("inissue", array("action" => "getstockbalance"));?>',
		});
	};
	initIssueRows();
	setTimeout(initIssueRows, 0);
	$('#trdetails_table tbody tr').each(function(){
		var rowId = $(this).attr('id');
		$('#item-'+rowId).trigger('change');
	});

	/*** Form Validation ***/  
		const fv = FormValidation.formValidation(document.getElementById('form'), {
			fields: {
				issue_date: {
					validators: {
						notEmpty: {
							message: 'Please select dispatch date.'
						},
					},
				},
				from_location: {
					validators: {
						notEmpty: {
							message: 'Please select source location.'
						}
					}
				}, 
				activity: {
					validators: {
						notEmpty: {
							message: 'Please select activity.'
						}
					}
				},
				department: {
					validators: {
						notEmpty: {
							message: 'Please select department.'
						}
					}
				},
				issued_to: {
					validators: {
						notEmpty: {
							message: 'Please select employee.'
						}
					}
				},
				'item[]': {
					validators: {
						notEmpty: {
							message: 'Please select item.'
						}
					}
				},
				/*'batch[]': {
					validators: {
						notEmpty: {
							message: 'Please provide batch.'
						}
					}
				},*/
				'from_balance[]': {
					validators: {
						callback: {
							message: 'The source quantity must be greater than 0',
							callback: function(input) {
								var qty = parseFloat(String(input.value || '').replace(/,/g, ''));
								return !isNaN(qty) && qty > 0;
							}
						}
					}
				},
				'uom[]': {
					validators: {
						notEmpty: {
							message: 'Please select uom.'
						}
					}
				},
				'quantity[]': {
					validators: {
						notEmpty: {
							message: 'Please provide quantity.'
						},
						callback: {
							message: 'Issue quantity cannot be greater than stock quantity.',
							callback: function(input) {
								var $input = $(input);
								var rowId = $input.closest('tr').attr('id');
								var stockValue = '';
								if(rowId && $('#from_balance-'+rowId).length){
									stockValue = $('#from_balance-'+rowId).val();
								} else {
									stockValue = $input.closest('tr').find('input[name="from_balance[]"]').val();
								}
								var stockQty = parseFloat(String(stockValue || '').replace(/,/g, ''));
								var issueQty = parseFloat(String(input.value || '').replace(/,/g, ''));
								if(!$.isNumeric(issueQty)){
									return false;
								}
								if(!$.isNumeric(stockQty)){
									return true;
								}
								return issueQty <= stockQty;
							}
						}
					}
				},
			},
			plugins: {
				trigger: new FormValidation.plugins.Trigger(),
				bootstrap3: new FormValidation.plugins.Bootstrap3(),
				submitButton: new FormValidation.plugins.SubmitButton(),
				defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
			},
		}).on('core.element.validated', function (e) {
			if (e.valid) {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-invalid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-valid');
			} else {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-valid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-invalid');
			}
		});  
});
</script>
