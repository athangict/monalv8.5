<script type="text/javascript">
$(function() {	
$('#issue_date').datepicker();
	$('#issue_date').on('changeDate',function(){
		$('form').formValidation('revalidateField', $(this).attr('id'));
	});

	$('#dispatch_date').datepicker();
	$('#dispatch_date').on('changeDate',function(){
		$('form').formValidation('revalidateField', $(this).attr('id'));
	});
	$('#department').change(function(){
		$('#issued_to').html("<option value=''></option>").trigger('chosen:updated');
		$('#to_location').val('');
		$.post(
			'<?php echo $this->url("inissue", array("action" => "getissuedtoemployee"));?>',
			{
				department: $(this).val()
			},
			function(data){
				$('#issued_to').html(data.employees);
				$('#issued_to').trigger('chosen:updated');
			},
			'json'
		);
	});
	$('#issued_to').change(function(){
		var locationId = $('#issued_to option:selected').data('location') || '';
		$('#to_location').val(locationId);
	});

	$('#trdetails_table').issue({
		getToLocation:'<?php echo $this->url('inissue', array('action' => 'gettolocation'));?>',
		getItem:'<?php echo $this->url("inissue", array("action" => "getitemgroup"));?>',
		getDetails:'<?php echo $this->url("inissue", array("action" => "getdetails"));?>',
		getStockBalance:'<?php echo $this->url("inissue", array("action" => "getstockbalance"));?>',
	});
	$(document).on('input keyup change', '#trdetails_table tbody input[id^="quantity-"]', function(){
		var rowId = $(this).closest('tr').attr('id');
		var stockQty = parseFloat($('#from_balance-'+rowId).val());
		var issueQty = parseFloat($(this).val());
		if($.isNumeric(stockQty) && $.isNumeric(issueQty) && issueQty > stockQty){
			$(this).val(parseFloat(stockQty).toFixed(2)).trigger('input');
		}
	});

	/*** Form Validation ***/   
		const fv = FormValidation.formValidation(document.getElementById('form'), {
			fields: {
				issue_date: {
					validators: {
						notEmpty: {
							message: 'Please select issue date.'
						},
					},
				},
				from_location: {
					validators: {
						notEmpty: {
							message: 'Please select source location.'
						}
					}
				}, 
				department: {
					validators: {
						notEmpty: {
							message: 'Please select department.'
						}
					}
				},
				issued_to: {
					validators: {
						notEmpty: {
							message: 'Please select employee.'
						}
					}
				},
				activity: {
					validators: {
						notEmpty: {
							message: 'Please select activity.'
						}
					}
				},
				sub_head: {
					validators: {
						notEmpty: {
							message: 'Please select sub head.'
						}
					}
				},
				'item[]': {
					validators: {
						notEmpty: {
							message: 'Please select item.'
						}
					}
				},
				/*'batch[]': {
					validators: {
						notEmpty: {
							message: 'Please provide batch.'
						}
					}
				},*/
				'uom[]': {
					validators: {
						notEmpty: {
							message: 'Please select uom.'
						}
					}
				},
				'quantity[]': {
					validators: {
						notEmpty: {
							message: 'Please provide quantity.'
						},
					}
				},
			},
			plugins: {
				trigger: new FormValidation.plugins.Trigger(),
				bootstrap3: new FormValidation.plugins.Bootstrap3(),
				submitButton: new FormValidation.plugins.SubmitButton(),
				defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
			},
		}).on('core.element.validated', function (e) {
			if (e.valid) {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-invalid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-valid');
			} else {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-valid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-invalid');
			}
		});

});
</script>
