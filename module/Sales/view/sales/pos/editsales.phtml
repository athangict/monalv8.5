					console.log(data);
					$("#item").html(data.items);	
					$("#item").trigger('chosen:updated');
				},
				'json'
			);	
		});
		$('#quantity').on('change', function(){
			if($('#stock_qty').val()-$(quantity).val()<0){
				alert('Entered quantity exceeds available stock!');
				$('#quantity').css('background-color', '#FFCCCC');
			} else {
				$('#quantity').css('background-color', ''); // Reset background color
			}
		});
		$('Select#item').on('change', function(){
			$.post(
				"<?php echo $this->url('pos', array('action' => 'getuom')); ?>",
				{
					itemId: $(this).val(),
