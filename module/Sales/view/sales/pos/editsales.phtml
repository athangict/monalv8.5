<script>
	var room = 0;
	function item_reset(row) {
		row.find('.tr_item_subgroup').val('').trigger('chosen:updated');
		row.find('.tr_item').html('<option value="">Select</option>').trigger('chosen:updated');
		row.find('.tr_quantity').val('');
		row.find('.tr_basic_uom').val('');
		row.find('.tr_rate').val('0.00');
		row.find('.tr_stock_qty').val('0.00');
		row.find('.tr_amount').val('0.00');
		row.find('.tr_gst_rate').val('0.00');
		row.find('.tr_gst_amount').val('0.00');
		row.find('.tr_net_total').val('0.00');
		row.find('input[name="id[]"]').remove();
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();
	}
	function item_delbtn() {
		var rows = $('#item_field_body tr');
		if (rows.length > 1) {
			rows.each(function() {
				var currentRow = $(this);
				if (currentRow.find('input[name="id[]"]').length > 0) {
					return;
				}
				currentRow.find('td:last').html("<a class='btn btn-warning btn-xs delRow' style='margin-top:5px;' href='javascript:void(0);'><i class='fa fa-times'></i></a>");
			});
			$('#item_field_body td a.delRow').off('click').on('click', function() {
				remove_item_fields(this);
			});
		} else {
			rows.each(function() {
				var currentRow = $(this);
				if (currentRow.find('input[name="id[]"]').length > 0) {
					return;
				}
				currentRow.find('td:last').html("<a class='btn btn-warning btn-xs resetRow' style='margin-top:5px;' href='javascript:void(0);'><i class='fa fa-refresh'></i></a>");
			});
			$('#item_field_body td a.resetRow').off('click').on('click', function() {
				item_reset($(this).closest('tr'));
			});
		}
	}
	function item_fields() {
		var lastRow = parseInt($('#item_field_body tr:last').attr('id'), 10) || 0;
		var tmplt_row = $('#item_field_body tr:first').clone(false);
		var clone = tmplt_row.clone();
		clone.find('div.chosen-container').remove();
		clone.find('select').each(function() {
			$(this).removeClass('chosen-done').show();
			$(this).next('.chosen-container').remove();
		});
		clone.attr('id', ++lastRow);
		clone.find(':input').each(function() {
			var old_id = $(this).attr('id');
			if (!old_id) {
				return;
			}
			var new_id = (old_id.lastIndexOf('-') > 0) ? old_id.substr(0, old_id.lastIndexOf('-')) : old_id;
			$(this).attr('id', new_id + '-' + lastRow);
			$(this).addClass('tr-' + new_id);
		});
		clone.find('td:last').html("<a class='btn btn-warning btn-xs' style='margin-top:5px;' href='javascript:void(0);' onclick='remove_item_fields(this);'><i class='fa fa-times'></i></a>");
		$('#item_field_body').append(clone);
		item_reset(clone);
		if ($.fn.chosen) {
			clone.find('select').chosen();
		}
		item_delbtn();
	}
	function remove_item_fields(el) {
		$(el).closest('tr').remove();
		item_delbtn();
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();
	}
	// Use the document as the parent and delegate the event to the .tr_item_subgroup class
	$(document).on('change', '.tr_item_subgroup', function() {
		var selectedItemSubgroup = $(this).val(); // get the value of the changed .tr_item_subgroup
		var relatedItemElement = $(this).closest('tr').find('.tr_item'); // find the related .tr_item in the same row
		
		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
			"<?php echo $this->url('pos', array('action' => 'getItemChange')); ?>",
			{
				locationId: $("#location").val(),
				item_subgroup: selectedItemSubgroup,
			},
			function(data) {
				relatedItemElement.html(data.items); // updating the related .tr_item
				relatedItemElement.trigger('chosen:updated'); // if you're using chosen plugin
				
			},
			'json'
		);  
	});
	
	$(document).on('change', '.tr_item', function() {
		var selectedItem = $(this).val(); // get the value of the changed .tr_item_subgroup
		var row = $(this).closest('tr');
		var relatedItemElement = row.find('.tr_rate'); // find the related .tr_item in the same row
		var relatedItemElement1 = row.find('.tr_stock_qty');
		var relatedItemElement2 = row.find('.tr_cost_price');
		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
				"<?php echo $this->url('pos', array('action' => 'getrate')); ?>",
				{
					item:selectedItem,
					location:$('#location').val(),
				},
				function(data){
					console.log(data);
					relatedItemElement.val(data.rate);
					relatedItemElement1.val(data.quantity);	
					relatedItemElement2.val(data.cost_price);
					row.find('.tr_gst_rate').val(parseFloat(data.gst_rate || 0).toFixed(2));
					$.post(
						"<?php echo $this->url('pos', array('action' => 'getuom')); ?>",
						{
							itemId: selectedItem,
						},
						function(uomData) {
							row.find('.tr_basic_uom').val(uomData.uom || '');
						},
						'json'
					);
					calculateTotal(relatedItemElement);
				},
				'json'
			);	
	});
	
	$(document).on('change', '.tr_item', function() {
		var selectedItem = $(this).val(); // get the value of the changed .tr_item_subgroup
		var relatedItemElement = $(this).closest('tr').find('.tr_basic_uom'); // find the related .tr_item in the same row
		
		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
			"<?php echo $this->url('pos', array('action' => 'getuom')); ?>",
			{
				itemId: selectedItem,
			},
			function(data) {
				relatedItemElement.val(data.uom); // updating the related .tr_item
				
			},
			'json'
		);  
	});
	//on rate and quantity change, call calculateTotal()
	$(document).on('input', '.tr_rate, .tr_quantity', function() {
		calculateTotal($(this));
	});
		$(document).on('input', '.tr_amount,.tr_quantity', function () {
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();
		});

		//Calculate amount on rate and quantity change
	function calculateTotal(element) {
		var row = element.closest('tr');  // Get the closest table row

		var rateInput = row.find('.tr_rate');  // Adjusted these to use class selectors and scope within the row
		var quantityInput = row.find('.tr_quantity');
		var totalInput = row.find('.tr_amount'); // Assuming there's a field for the total amount with the class "tr_amount"
		var gstRateInput = row.find('.tr_gst_rate');
		var gstAmountInput = row.find('.tr_gst_amount');
		var netTotalInput = row.find('.tr_net_total');

		var rate = parseFloat(rateInput.val()) || 0;
		var quantity = parseFloat(quantityInput.val()) || 0;
		var total = rate * quantity;
		var gstRate = parseFloat(gstRateInput.val()) || 0;
		var gstAmount = (gstRate / 100) * total;
		var netTotal = total + gstAmount;

		totalInput.val(total.toFixed(2));  // Assuming you want to show up to two decimal places
		gstAmountInput.val(gstAmount.toFixed(2));
		netTotalInput.val(netTotal.toFixed(2));
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();
	}

	$(document).on('input', '.tr_amount, .tr_gst_amount, .tr_net_total', function() {
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();
	});
	
	function calculateSummaryTotals() {
		var grandTotal = 0.0;
		var totalGst = 0.0;
		var discount = parseFloat($('#discount').val()) || 0;
		$('.tr_amount').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) {
				grandTotal += amount;
			}
		});
		$('.tr_gst_amount').each(function() {
			var gstAmount = parseFloat($(this).val());
			if (!isNaN(gstAmount)) {
				totalGst += gstAmount;
			}
		});
		var totalDiscount = grandTotal * (discount/100);
		var totalAfterDiscount = grandTotal - totalDiscount;
		if (discount > 0 && grandTotal > 0) {
			totalGst = totalGst * (totalAfterDiscount / grandTotal);
		}
		var netTotal = totalAfterDiscount + totalGst;
		$('#total').val(grandTotal.toFixed(2));
		$('#total_discount').val(totalDiscount.toFixed(2));
		$('#total_after_discount').val(totalAfterDiscount.toFixed(2));
		$('#total_gst').val(totalGst.toFixed(2));
		$('#net_amount').val(netTotal.toFixed(2));
	}
	function calculateTotalAmount() { calculateSummaryTotals(); }
	function calculateTotalGst() { calculateSummaryTotals(); }
	function calculateTotalNet() { calculateSummaryTotals(); }
	$('#discount').on('change', function() {
		calculateTotalNet();
	});
	
	$(document).on('input', '.tr_quantity', function() {
    // Fetch the entered quantity from the changed input
    var enteredQuantity = parseFloat($(this).val()) || 0;
    
    // Find the related stock quantity in the same row
    var stockQtyElement = $(this).closest('tr').find('.tr_stock_qty');
    var stockQty = parseFloat(stockQtyElement.val()) || 0;
		console.log("Hello");
    // Check if entered quantity exceeds stock quantity
    if (stockQty - enteredQuantity < 0) {
        alert('Entered quantity exceeds available stock!');
        $(this).val(stockQty); // Reset to max available quantity (optional)
        // Add visual cue by changing the background color
        $(this).css('background-color', '#FFCCCC');
    } else {
        // Reset background color if the entered quantity is valid
        $(this).css('background-color', '');
    }

    // Call a function to calculate the total
    calculateTotal($(this));
});
	
	function updateSalesModeFields(mode) {
		var isCredit = mode === "y";
		var showPayment = !isCredit && mode !== "1";
		$('#due_dates,#ref_no').toggle(isCredit);
		$('#customers').toggle(!showPayment);
		$('#payment,#account').toggle(showPayment);
		$('#account_no').prop('required', showPayment);
	}
	$(document).ready(function (){
		updateSalesModeFields($('input[type=radio][name=credit]:checked').val());
		$('#item_field_body tr').each(function() {
			$(this).attr('id', ++room);
			$(this).find(':input').each(function() {
				var old_id = $(this).attr('id');
				if (!old_id) {
					return;
				}
				var new_id = (old_id.lastIndexOf('-') > 0) ? old_id.substr(0, old_id.lastIndexOf('-')) : old_id;
				$(this).attr('id', new_id + '-' + room);
				$(this).addClass('tr-' + new_id);
			});
		});
		item_delbtn();
		calculateTotalAmount();
		calculateTotalGst();
		calculateTotalNet();

		var customerRequest;
		$('input[type=radio][name=credit]').change(function(){
			var mode = $(this).val();
			var customer = $('#customer');
			if (customerRequest) {
				customerRequest.abort();
			}
			updateSalesModeFields(mode);
			$('#payment_type').trigger('change');
			if (mode !== "y" && mode !== "1") {
				customer.empty().append(new Option('Nil', '0')).trigger('chosen:updated');
				return;
			}
		customer.empty().append(new Option('Loading customers...', '-1')).trigger('chosen:updated');
		customerRequest = $.post(
			"<?php echo $this->url('pos', array('action' => 'getcustomer')); ?>",
			{
				id: mode,
				source: 'editsales'
			},
			function(data){
				customer.html(data.customer).trigger('chosen:updated');
			},
			'json'
		).fail(function(xhr, status){
			if (status !== 'abort') {
				customer.empty().append(new Option('Unable to load customers', '-1')).trigger('chosen:updated');
			}
		});
    });
		$('#item,#location').on('change', function(){
			$.post(
				"<?php echo $this->url('pos', array('action' => 'getrate')); ?>",
				{
