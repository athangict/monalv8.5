<script type="text/javascript">
	(function(){
		var bindIssueViewActions = function(){
			if(typeof window.jQuery === 'undefined'){
				return false;
			}
			var $ = window.jQuery;
			$('#tc_btn').off('click.issue').on('click.issue', function(){
				window.document.location = "<?php echo $this->url('transporter', array('action' => 'viewtranspcharge','id' => $tc_id));?>";
			});
			var $printButton = $('#print');
			if(!$printButton.length){
				return true;
			}
			if($printButton.data('pdf-bound') === 1){
				return true;
			}
			if($.isFunction($.fn.genpdfinvoice3)){
				$printButton.genpdfinvoice3({
					content: '#report-print',
					src:"<?php echo $this->url('print', array('action' => 'index'));?>",
					orentation:"P",
					size: 'A4'
				});
				$printButton.data('pdf-bound', 1);
			}else if($.isFunction($.fn.genpdfinvoice)){
				$printButton.genpdfinvoice({
					content: '#report-print',
					src:"<?php echo $this->url('pdfxls', array('action' => 'pdf'));?>",
					orentation:"L"
				});
				$printButton.data('pdf-bound', 1);
			}
			return ($printButton.data('pdf-bound') === 1);
		};
		var bindAttempts = 0;
		var bindTimer = window.setInterval(function(){
			bindAttempts++;
			if(bindIssueViewActions() || bindAttempts >= 50){
				window.clearInterval(bindTimer);
			}
		}, 200);
		bindIssueViewActions();
	})();
</script>

