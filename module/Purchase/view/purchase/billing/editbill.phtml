<script type="text/javascript">
var room = 1;
function sh_field() {
    room++;
    var newRow = `
    <tr class="form-group removeclass${room}">
        <td>
			<select class="form-control tr_sub_head" name="sub_head[]" id="sub_head"  required>
				<option value=""></option>
				<?php foreach ($shead as $sheads): ?>
					<option value="<?php echo $sheads['id']; ?>"><?php echo $sheads['name']; ?></option>
				<?php endforeach; ?>
			</select>
		</td>
		<td >
			<input class="form-control tr_amount mr-2" name="amount[]" id="amount" required>
		</td>
		<td >
			<input class="form-control tr_gst_amount mr-2" name="gst_amount[]" id="gst_amount" required>
		</td>
		<td >
			<input class="form-control tr_ptotal mr-2" name="ptotal[]" id="ptotal" readonly>
		</td><td >
			<input class="form-control tr_pref_no mr-2" name="pref_no[]" id="pref_no" >
		</td>
		<td>
            <input class="form-control tr_remark" name="remark[]" id="remark" >
        </td>
		<td class="bill-row-action"></td>
    </tr>`;
    $('#sh_field tbody').append(newRow);
    refresh_bill_row_buttons();
    calculateTotalAmount();
}
function reset_bill_row(rowObj){
	rowObj.find('.tr_sub_head').val('').trigger('chosen:updated');
	rowObj.find('.tr_amount').val('');
	rowObj.find('.tr_gst_amount').val('');
	rowObj.find('.tr_ptotal').val('');
	rowObj.find('.tr_pref_no').val('');
	rowObj.find('.tr_remark').val('');
	calculateTotalAmount();
}
function refresh_bill_row_buttons(){
	var rowCount = $('#sh_field tbody tr').length;
	$('#sh_field tbody tr').each(function(){
		var actionCell = $(this).find('.bill-row-action');
		if(rowCount > 1){
			actionCell.html("<button class='btn btn-warning btn-xs bill-row-remove' type='button' style='margin-top:5px;'><i class='fa fa-times'></i></button>");
		}else{
			actionCell.html("<button class='btn btn-warning btn-xs bill-row-reset' type='button' style='margin-top:5px;'><i class='fa fa-refresh'></i></button>");
		}
	});
}
$(document).on('click', '.bill-row-remove', function () {
	$(this).closest('tr').remove();
	refresh_bill_row_buttons();
	calculateTotalAmount();
});
$(document).on('click', '.bill-row-reset', function () {
	reset_bill_row($(this).closest('tr'));
});
	$(document).on('input', '.tr_amount, .tr_gst_amount', function() {

		var amountnput = $(this).closest('tr').find('.tr_amount');  // Adjusted these to use class selectors and scope within the row
		var gstInput = $(this).closest('tr').find('.tr_gst_amount');
		var totalInput = $(this).closest('tr').find('.tr_ptotal'); // Assuming there's a field for the total amount with the class "tr_amount"

		var amount = parseFloat(amountnput.val()) || 0;
		var gst = parseFloat(gstInput.val()) || 0;
		var total = amount + gst;
		totalInput.val(total);
calculateTotalAmount();		
		
	});
	function calculateTotalAmount() {
		console.log("calculateTotal amount");
		
		var total = parseFloat($('#sup_total').val()) ||0;
		var totalgst =parseFloat($('#sup_gst').val()) || 0;
		var totalamt =parseFloat($('#net').val()) || 0;
		// Iterate over each amount input field in the table
		$('.tr_ptotal').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				total += amount;
			}
		});
		$('.tr_gst_amount').each(function() {
			var gstamount = parseFloat($(this).val());
			if (!isNaN(gstamount)) { // Make sure it's a valid number
				totalgst += gstamount;
			}
		});
		$('.tr_amount').each(function() {
			var totamount = parseFloat($(this).val());
			if (!isNaN(totamount)) { // Make sure it's a valid number
				totalamt += totamount;
			}
		});

		// Update the #total field with the new sum
		$('#grand_tot').val(total.toFixed(2));
		$('#tot_gst').val(totalgst.toFixed(2));
		$('#tot_amount').val(totalamt.toFixed(2));
	}
$(document).ready(function (){
	refresh_bill_row_buttons();
	$('#billing_date').datepicker();
	$("#location").trigger('change');
	$('#prn_no').on('change', function(){
		//alert($(this).val());
		$.post(
			"<?php echo $this->url('billing', array('action' => 'getsupplier')); ?>",
			{
				prn_no: $(this).val(),
			},
			function(data){
				console.log(data);
				$("#supplier").html(data.supplier);	
				$("#supplier").trigger('chosen:updated');
				$("#receipt_amt").val(data.sum);	
				$("#net").val(data.sum);	
				$("#total").val(data.sum);	
				calculateTotalAmount();
			},
			'json'
		);	
		
	});
	
	var prnamInput = $('#receipt_amt');
	var discountInput = $('#discount');
	var sup_gst = $('#sup_gst');

	prnamInput.on('input', calculateTotal);
	discountInput.on('input', calculateTotal);
	sup_gst.on('input', calculateTotal);

	function calculateTotal() {
		var prnamInputValue = prnamInput.val();
		var prnam = parseFloat(prnamInputValue.replace(/,/g, '')) || 0;
		var discount = parseFloat(discountInput.val()) || 0;
		var supgst = parseFloat(sup_gst.val()) || 0;
		
		var net = prnam - discount;
		var total=net+supgst;
		if (isNaN(total) || isNaN(net)) { 
			// Handle invalid input values
			return;
		}

		$('#sup_total').val(total.toFixed(2));
		$('#net').val(net.toFixed(2));
		calculateTotalAmount();	
	}
	
	
	/*** form validation***/ 
	const fv = FormValidation.formValidation(document.getElementById('#form'), {
		fields: {
			'billing_date': {
				validators: {
					notEmpty: {
						message: 'Please select payment date.'
					}
				}
			},
			'location': {
				validators: {
					notEmpty: {
						message: 'Please select location.'
					}
				}
			},
			'payment_type': {
				validators: {
					notEmpty: {
						message: 'Please select payment type.'
					}
				}
			},                        
		},
		plugins: {
			trigger: new FormValidation.plugins.Trigger(),
			bootstrap3: new FormValidation.plugins.Bootstrap3(),
			submitButton: new FormValidation.plugins.SubmitButton(),
			defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
		},
	}).on('core.element.validated', function (e) {
		if (e.valid) {
			$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-invalid');
			$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-valid');
		} else {
			$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-valid');
			$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-invalid');
		}
	});

});
</script>