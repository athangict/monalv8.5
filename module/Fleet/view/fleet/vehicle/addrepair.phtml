<script type="text/javascript">	
$('#date').datepicker(); 
function purchase_reset(row) {
	row.find('.tr_service').val('').trigger('chosen:updated');
	row.find('.tr_item').html('<option value=""></option>').trigger('chosen:updated');
	row.find('.tr_amount').val('0.00');
	row.find('.tr_plate').val('');
	calculateTotalAmount();
}
function purchase_actionbtn() {
	if ($('#purchase_field_body tr').length > 1) {
		var delBtn = "<a value='Delete' class='btn btn-warning btn-xs delRow' style='margin-top:5px;'><i class='fa fa-times'></i></a>";
		$('#purchase_field_body tr').each(function() {
			$(this).find('td:last').html(delBtn);
		});
		$('#purchase_field_body td a.delRow').each(function() {
			$(this).off('click').on('click', function() {
				remove_purchase_field($(this).closest('tr'));
			});
		});
	} else {
		var resetBtn = "<a value='Reset' class='btn btn-warning btn-xs resetRow' style='margin-top:5px;'><i class='fa fa-refresh'></i></a>";
		$('#purchase_field_body tr').each(function() {
			$(this).find('td:last').html(resetBtn);
		});
		$('#purchase_field_body td a.resetRow').each(function() {
			$(this).off('click').on('click', function() {
				purchase_reset($(this).closest('tr'));
			});
		});
	}
}
function purchase_field() {
	var lastRow = parseInt($('#purchase_field_body tr:last').attr('id'), 10) || 0;
	var tmplt_row = $('#purchase_field_body tr:first').clone(false);
	var clone = tmplt_row.clone();
	clone.find('div.chosen-container').remove();
	clone.find('select').each(function() {
		$(this).removeClass('chosen-done').show();
		$(this).next('.chosen-container').remove();
	});
	clone.attr('id', ++lastRow);
	clone.find(':input').each(function() {
		var old_id = $(this).attr('id');
		if (!old_id) {
			return;
		}
		var new_id = (old_id.lastIndexOf('-') > 0) ? old_id.substr(0, old_id.lastIndexOf('-')) : old_id;
		$(this).attr('id', new_id + '-' + lastRow);
		$(this).addClass('tr-' + new_id);
	});
	$('#purchase_field_body').append(clone);
	purchase_reset(clone);
	if ($.fn.chosen) {
		clone.find('select').chosen();
	}
	purchase_actionbtn();
}
function remove_purchase_field(row) {
	row.remove();
	purchase_actionbtn();
	calculateTotalAmount();
}
function refreshHeadByLocation() {
	var selectedLocation = $('#location').val();
	$.post(
		"<?php echo $this->url('vehicle', array('action' => 'getlocationhead')); ?>",
		{
			locationId: selectedLocation,
		},
		function(data) {
			$('#purchase_field_body .tr_service').each(function() {
				$(this).html(data.head);
				$(this).val('');
				$(this).trigger('chosen:updated');
				$(this).closest('tr').find('.tr_item').html('<option value=""></option>').trigger('chosen:updated');
				$(this).closest('tr').find('.tr_plate').val('');
			});
		},
		'json'
	);
}
$('#location').on('change', function() {
	refreshHeadByLocation();
});
$(document).on('change', '.tr_service', function() {
    var selectedService = $(this).closest('tr').find('.tr_service').val();
    var selectedLocation = $('#location').val();
    var relatedItemElement = $(this).closest('tr').find('.tr_item');

    $.post(
        "<?php echo $this->url('vehicle', array('action' => 'gettransport')); ?>",
        {
            serviceId: selectedService,
            locationId: selectedLocation,
        },
        function(data) {
            relatedItemElement.html(data.item);
            relatedItemElement.trigger('chosen:updated');
		  },
        'json'
    );  
});
$(document).on('change', '.tr_service, .tr_item', function() {
    var selectedService = $(this).closest('tr').find('.tr_service').val();
     var selectedItem = $(this).closest('tr').find('.tr_item').val();
    var relatedItemElement = $(this).closest('tr').find('.tr_plate');

    $.post(
        "<?php echo $this->url('vehicle', array('action' => 'getplate')); ?>",
        {
            serviceId: selectedService,
            itemId: selectedItem,
        },
        function(data) {
            relatedItemElement.val(data.license_plate);
		 },
        'json'
    );  
});
