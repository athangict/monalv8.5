<script type="text/javascript">	 
var room = 1;
	var assetClassId = '33';
	function isAssetModeEnabled(){
		return $('#is_asset_order').is(':checked');
	}
	function initPurchaseChosen(scopeObj){
		if(!(window.jQuery && $.fn && $.fn.chosen)){
			return;
		}
		var selects = $(scopeObj).find('select');
		selects.each(function(){
			if($(this).data('chosen')){
				$(this).chosen('destroy');
			}
		});
		selects.chosen({
			width: '100%',
			disable_search_threshold: 0
		});
	}
	function reset_purchase_row(rowObj){
		rowObj.find('.tr_item_class').val('').trigger('chosen:updated').trigger('change');
		rowObj.find('.tr_item').html('<option value="0"></option>').val('0').trigger('change');
		rowObj.find('.tr_subhead').html("<option value=''></option>").trigger('chosen:updated');
		rowObj.find('.tr_uom').html("<option value='1'></option>").trigger('chosen:updated');
		rowObj.find('.tr_quantity').val('');
		rowObj.find('.tr_rate').val('');
		rowObj.find('.tr_amount').val('0.00');
		rowObj.find('.tr_remarks').val('');
		rowObj.find('.tr_item_name').val('');
		rowObj.find('.asst_container, #asst_container').hide();
		rowObj.find('.item_container, #item_container').show();
		rowObj.find('.asset-class-label').hide();
		if(isAssetModeEnabled()){
			applyAssetModeToRow(rowObj, true);
		}
		calculateTotalAmount();
	}
	function loadAssetSubheadAndUom(rowObj){
		var subheadElement = rowObj.find('.tr_subhead');
		var uomElement = rowObj.find('.tr_uom');
		$.post(
			"<?php echo $this->url('purorder', array('action' => 'getsubhead')); ?>",
			{
				isAsset: 1
			},
			function(data) {
				subheadElement.html(data.subheadlist);
				subheadElement.trigger('chosen:updated');
			},
			'json'
		);
		$.post(
			"<?php echo $this->url('purorder', array('action' => 'getuom')); ?>",
			{
				isAsset: 1
			},
			function(data) {
				uomElement.html(data.uom);
				uomElement.trigger('chosen:updated');
			},
			'json'
		);
	}
	function applyAssetModeToRow(rowObj, enabled){
		var itemClass = rowObj.find('.tr_item_class');
		var itemSelect = rowObj.find('.tr_item');
		var itemNameInput = rowObj.find('.tr_item_name');
		var itemContainer = rowObj.find('.item_container, #item_container');
		var assetContainer = rowObj.find('.asst_container, #asst_container');
		var assetLabel = rowObj.find('.asset-class-label');
		if(enabled){
			itemClass.val(assetClassId).trigger('chosen:updated');
			itemClass.closest('.form-group').find('.chosen-container').hide();
			itemSelect.prop('required', false);
			itemNameInput.prop('required', true);
			itemContainer.hide();
			assetContainer.show();
			assetLabel.show();
			itemSelect.html('<option value="0"></option>').val('0').trigger('chosen:updated');
			loadAssetSubheadAndUom(rowObj);
		}else{
			itemClass.closest('.form-group').find('.chosen-container').show();
			itemSelect.prop('required', true);
			itemNameInput.prop('required', false);
			itemContainer.show();
			assetContainer.hide();
			assetLabel.hide();
			rowObj.find('.tr_subhead').html("<option value=''></option>").trigger('chosen:updated');
			rowObj.find('.tr_uom').html("<option value='1'></option>").trigger('chosen:updated');
		}
	}
	function applyAssetModeToAllRows(){
		var enabled = isAssetModeEnabled();
		$('#purchase_field tbody tr').each(function(){
			applyAssetModeToRow($(this), enabled);
		});
	}
	function refresh_purchase_row_buttons(){
		var rowCount = $('#purchase_field tbody tr').length;
		$('#purchase_field tbody tr').each(function(){
			var actionCell = $(this).find('.po-row-action');
			if(rowCount > 1){
				actionCell.html("<button class='btn btn-warning btn-xs po-row-remove' type='button' style='margin-top:5px;'><i class='fa fa-times'></i></button>");
			}else{
				actionCell.html("<button class='btn btn-warning btn-xs po-row-reset' type='button' style='margin-top:5px;'><i class='fa fa-refresh'></i></button>");
			}
		});
	}
	function purchase_field() {
    room++;
    var objTo = document.querySelector('#purchase_field tbody');
    var divtest = document.createElement('tr');
    divtest.setAttribute('class', 'form-group removeclass' + room);
    
    divtest.innerHTML = 
    '<td class="col-lg-2"><div class="form-group"><select name="item_class[]" class="form-control tr_item_class" data-placeholder="Select" required><option value="-1">Select</option><?php foreach($itemcls as $item): ?><option value="<?php echo $item['id']; ?>"><?php echo $item['item_class']; ?></option><?php endforeach; ?></select><span class="asset-class-label" style="display:none;">Asset</span></div></td><td class="col-lg-2 input-cell"><div class="form-group item_container"><select name="item[]" class="form-control tr_item" data-placeholder="Select" required><option value="0">Select</option></select></div><div class="form-group asst_container" style="display:none;"><input class="form-control tr_item_name" name="item_name[]" data-placeholder="Enter item name"></div></td><td class="col-lg-2 input-cell"><div class="form-group"><select name="subhead[]" class="form-control tr_subhead" data-placeholder="Select" required><option value=""></option></select></div></td><td class="col-lg-2 input-cell"><div class="form-group"><select name="uom[]" class="form-control tr_uom" data-placeholder="Select" required><option value=1></option></select></div></td><td class="col-lg-1"><div class="form-group"><input type="text" class="form-control tr_quantity" name="quantity[]" value=""></div></td><td class="col-lg-1"><div class="form-group"><input type="text" class="form-control tr_rate" name="rate[]" placeholder="rate"></div></td><td class="col-lg-1"><div class="form-group"><input type="text" class="form-control tr_amount" name="amount[]" value="" readonly></div></td><td class="col-lg-2"><div class="form-group"><input type="text" class="form-control tr_remarks" placeholder="remarks" name="remarks[]"></div></td><td class="col-lg-1 input-cell po-row-action"></td>';
	objTo.appendChild(divtest);
		calculateTotalAmount()
		initPurchaseChosen(divtest);
		applyAssetModeToRow($(divtest), isAssetModeEnabled());
		refresh_purchase_row_buttons();
    
	}
	function remove_purchase_field(rid) {
	$('.removeclass' + rid).remove();
	calculateTotalAmount()
	refresh_purchase_row_buttons();
	
	}
	$(document).ready(function() {
	initPurchaseChosen($('#purchase_field'));
	refresh_purchase_row_buttons();
	$(document).on('click', '.po-row-remove', function() {
		$(this).closest('tr').remove();
		calculateTotalAmount();
		refresh_purchase_row_buttons();
	});
	$(document).on('click', '.po-row-reset', function() {
		reset_purchase_row($(this).closest('tr'));
	});
	$('#is_asset_order').on('change', function(){
		applyAssetModeToAllRows();
	});
	applyAssetModeToAllRows();
});
	var loadRowSubhead = function(rowObj){
		var selectedItem = rowObj.find('.tr_item').val();
		var selectedClass = rowObj.find('.tr_item_class').val();
		var relatedSubheadElement = rowObj.find('.tr_subhead');
		$.post(
			"<?php echo $this->url('purorder', array('action' => 'getsubhead')); ?>",
			{
				itemId: selectedItem,
				itemclassId: selectedClass,
			},
			function(data) {
				relatedSubheadElement.html(data.subheadlist);
				relatedSubheadElement.trigger('chosen:updated');
			},
			'json'
		);
	};
	$(document).on('change', '.tr_item', function() {
		if(isAssetModeEnabled()){
			return;
		}
		var selectedItem = $(this).val(); // get the value of the changed .tr_item
		var relatedItemElement = $(this).closest('tr').find('.tr_uom'); // find the related .tr_uom in the same row
		var rowObj = $(this).closest('tr');
		
		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
			"<?php echo $this->url('purorder', array('action' => 'getuom')); ?>",
			{
				itemId: selectedItem,
			},
			function(data) {
				relatedItemElement.html(data.uom); // updating the related .tr_uom
				relatedItemElement.trigger('chosen:updated'); // if you're using chosen plugin
				
			},
			'json'
		);  
		loadRowSubhead(rowObj);
	});

	$(document).on('change', '.tr_item_class', function() {
		if(isAssetModeEnabled()){
			$(this).val(assetClassId).trigger('chosen:updated');
			return;
		}
		var selectedClass = $(this).val(); // get the value of the changed .tr_item
		var relatedItemElement = $(this).closest('tr').find('.tr_item'); // find the related .tr_item in the same row
		var subheadElement = $(this).closest('tr').find('.tr_subhead');
		var asst = $(this).closest('tr').find('.asst_container, #asst_container'); // find the related .tr_uom in the same row
		var items = $(this).closest('tr').find('.item_container, #item_container'); // find the related .tr_uom in the same row
		subheadElement.html("<option value=''></option>");
		subheadElement.trigger('chosen:updated');
		if(selectedClass==33){
			asst.show();
			items.hide();
		}
		else{
			asst.hide();
			items.show();

		// Assuming you want to do an AJAX call similar to what you've shown in your initial code:
		$.post(
			"<?php echo $this->url('purorder', array('action' => 'getitem')); ?>",
			{
				itemclassId: selectedClass,
			},
			function(data) {
				console.log(data);
				relatedItemElement.html(data.item); // updating the related .tr_uom
				relatedItemElement.trigger('chosen:updated'); // if you're using chosen plugin
				var selectedItem = relatedItemElement.val();
				if(selectedItem && selectedItem !== '0'){
					loadRowSubhead(relatedItemElement.closest('tr'));
				}
				
			},
			'json'
		);
	}  
	});
	$(document).on('input', '.tr_amount,.tr_quantity', function () {
		calculateTotalAmount();
		});
	$(document).on('input', '.tr_rate, .tr_quantity', function() {
		calculateTotal($(this));
	});
	$(document).on('blur', '.tr_rate', function() {
		var rate = parseFloat($(this).val());
		if (!isNaN(rate)) {
			$(this).val(rate.toFixed(2));
			calculateTotal($(this));
		}
	});
	
	function calculateTotal(element) {
		console.log("calculateTotal ");
		var row = element.closest('tr');  // Get the closest table row

		var rateInput = row.find('.tr_rate');  // Adjusted these to use class selectors and scope within the row
		var quantityInput = row.find('.tr_quantity');
		var totalInput = row.find('.tr_amount'); // Assuming there's a field for the total amount with the class "tr_amount"

		var rate = parseFloat(rateInput.val()) || 0;
		var quantity = parseFloat(quantityInput.val()) || 0;
		var total = rate * quantity;

		totalInput.val(total.toFixed(2));  // Assuming you want to show up to two decimal places
		calculateTotalAmount();
	}
	
	function calculateTotalAmount() {
		console.log("calculateTotal amount");
		var total = 0.0;

		// Iterate over each amount input field in the table
		$('.tr_amount').each(function() {
			var amount = parseFloat($(this).val());
			if (!isNaN(amount)) { // Make sure it's a valid number
				total += amount;
			}
		});

		// Update the #total field with the new sum
		$('#po_amount').val(total.toFixed(2));
	}	
