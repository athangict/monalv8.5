<script type="text/javascript">
    $(function() {
		function normalizeDateValue(value) {
			if (!value) {
				return value;
			}
			var dash = /^(\d{4})-(\d{2})-(\d{2})$/;
			if (dash.test(value)) {
				return value;
			}
			var slash = /^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/;
			var m = value.match(slash);
			if (!m) {
				return value;
			}
			var d = ('0' + m[1]).slice(-2);
			var mo = ('0' + m[2]).slice(-2);
			var y = m[3];
			if (y.length === 2) {
				y = '20' + y;
			}
			return y + '-' + mo + '-' + d;
		}

		function initTenantDate(selector) {
			var $el = $(selector);
			$el.val(normalizeDateValue($.trim($el.val())));
			if ($el.data('datepicker')) {
				$el.datepicker('destroy');
			}
			$el.datepicker({
				format: 'yyyy-mm-dd',
				autoclose: true,
				startView: 0,
				minViewMode: 0,
				maxViewMode: 2,
				forceParse: false,
				container: 'body'
			}).on('changeDate', function () {
				$el.val(normalizeDateValue($.trim($el.val())));
			});
		}

		initTenantDate('#agreement_date');
		initTenantDate('#start_date');
		initTenantDate('#end_date');
	});
	$('form select').chosen();
	$('document').ready(function(){
