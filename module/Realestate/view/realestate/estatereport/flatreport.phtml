								$levelRaw = isset($statusMap[$statusId]['level']) ? trim(strtolower((string)$statusMap[$statusId]['level'])) : '';
								$statusLevelClass = 'label-default';
								if($levelRaw !== ''):
									$levelAliases = array(
										'success' => 'label-success',
										'green' => 'label-success',
										'warning' => 'label-warning',
										'yellow' => 'label-warning',
										'info' => 'label-info',
										'blue' => 'label-info',
										'primary' => 'label-primary',
										'danger' => 'label-danger',
										'red' => 'label-danger',
										'default' => 'label-default',
										'secondary' => 'label-default',
									);
									if(is_numeric($levelRaw)):
										$levelIndex = (((int)$levelRaw - 1) % count($levelClasses)) + 1;
										$statusLevelClass = isset($levelClasses[$levelIndex]) ? $levelClasses[$levelIndex] : 'label-default';
									elseif(substr($levelRaw, 0, 6) === 'label-'):
										$statusLevelClass = $levelRaw;
									elseif(isset($levelAliases[$levelRaw])):
										$statusLevelClass = $levelAliases[$levelRaw];
									endif;
								else:
									$levelIndex = (($statusId - 1) % count($levelClasses)) + 1;
									$statusLevelClass = isset($levelClasses[$levelIndex]) ? $levelClasses[$levelIndex] : 'label-default';
								endif;
							?>
